<?xml version="1.0" encoding="utf-8"?>
<!-- QR mark: four rounded scan brackets around three finder squares and a small data cluster.

     Redrawn as a vector from the reference art rather than tracing the supplied JPEG, which was a
     stock-library comp with an ID printed across it — not something that can ship in a store build.

     Replaces ic_qr_code on the "Pair with QR" tile. That one is a 200dp, 25x25-viewport decorative
     full QR built for a tutorial placeholder: at 24dp its module field turns to mud, and its
     hardcoded #FF000000/#FFFFFFFF fills ignore android:tint, so it stayed black on a dark theme. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?attr/colorControlNormal">
    <path
        android:fillColor="@android:color/white"
        android:fillType="evenOdd"
        android:pathData="
            M2,9 L2,4 Q2,2 4,2 L9,2 L9,4 L4,4 L4,9 Z
            M22,9 L22,4 Q22,2 20,2 L15,2 L15,4 L20,4 L20,9 Z
            M2,15 L2,20 Q2,22 4,22 L9,22 L9,20 L4,20 L4,15 Z
            M22,15 L22,20 Q22,22 20,22 L15,22 L15,20 L20,20 L20,15 Z
            M6,6 h5 v5 h-5 z   M7.5,7.5 h2 v2 h-2 z
            M13,6 h5 v5 h-5 z  M14.5,7.5 h2 v2 h-2 z
            M6,13 h5 v5 h-5 z  M7.5,14.5 h2 v2 h-2 z
            M13,16 h2 v2 h-2 z
            M15,13 h2 v2 h-2 z
            M17,13 h2 v5 h-2 z" />
</vector>
