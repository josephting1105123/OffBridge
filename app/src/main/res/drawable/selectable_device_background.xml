<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Selected: faint accent fill, same light-grey outline -->
    <item app:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/appAccentMuted" />
            <stroke android:width="1dp" android:color="?attr/appDividerColor" />
            <corners android:radius="16dp" />
        </shape>
    </item>

    <!-- Default: light-grey outline (the default design) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/appCardColor" />
            <stroke android:width="1dp" android:color="?attr/appDividerColor" />
            <corners android:radius="16dp" />
        </shape>
    </item>

</selector>
