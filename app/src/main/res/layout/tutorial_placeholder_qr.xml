<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="10dp">

    <!-- Fake QR display: the same unified ic_qr_frame mark the real screens use, on the white plate
         a scannable code is always printed on. The tint is set explicitly to black — ic_qr_frame's
         own android:tint resolves to colorControlNormal, which on the dark theme is near-white and
         would vanish against this plate. -->
    <FrameLayout
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:background="#FFFFFF">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="14dp"
            android:src="@drawable/ic_qr_frame"
            app:tint="#000000"
            android:contentDescription="@null" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/send_via_nfc_qr"
        android:textColor="?attr/appTextPrimaryColor"
        android:textSize="13sp"
        android:textStyle="bold"/>

</LinearLayout>
