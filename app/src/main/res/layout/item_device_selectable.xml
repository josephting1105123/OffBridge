<?xml version="1.0" encoding="utf-8"?>
<com.EntropicSoftwareLab.ClipboardShare.SelectableDeviceCard
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/device_card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/selectable_device_background"
    android:padding="16dp"
    android:layout_marginBottom="12dp"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/tv_device_icon"
        android:layout_width="@dimen/header_icon"
        android:layout_height="@dimen/header_icon"
        android:src="@drawable/ic_device"
        android:tint="?attr/appGreen"
        android:contentDescription="@null"
        android:layout_marginEnd="16dp"/>

    <TextView
        android:id="@+id/tv_device_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/default_device_name"
        android:textColor="?attr/appTextPrimaryColor"
        android:textSize="16sp" />

</com.EntropicSoftwareLab.ClipboardShare.SelectableDeviceCard>