<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="16dp"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_bg"
    android:padding="@dimen/space_lg">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/send_via_title"
        android:textAppearance="@style/TextAppearance.App.Title"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/space_lg"/>

    <!-- Three options in a row: Connected Devices | QR | NFC -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/btn_send_via_devices"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="104dp"
            android:layout_marginEnd="@dimen/space_md"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/rect_button_bg"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">
            <ImageView
                android:layout_width="@dimen/icon_lg"
                android:layout_height="@dimen/icon_lg"
                android:src="@drawable/ic_device"
                app:tint="?attr/appGreen"
                android:contentDescription="@null" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/send_via_connected_devices"
                android:textColor="?attr/appTextPrimaryColor"
                android:textSize="13sp"
                android:gravity="center"
                android:maxLines="2"
                android:layout_marginTop="@dimen/space_sm" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_send_via_qr"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="104dp"
            android:layout_marginEnd="@dimen/space_md"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/rect_button_bg"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">
            <ImageView
                android:layout_width="@dimen/icon_lg"
                android:layout_height="@dimen/icon_lg"
                android:src="@drawable/ic_qr_scan"
                app:tint="?attr/appGreen"
                android:contentDescription="@null" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/send_via_qr"
                android:textColor="?attr/appTextPrimaryColor"
                android:textSize="13sp"
                android:gravity="center"
                android:maxLines="2"
                android:layout_marginTop="@dimen/space_sm" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_send_via_nfc"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="104dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/rect_button_bg"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">
            <ImageView
                android:layout_width="@dimen/icon_lg"
                android:layout_height="@dimen/icon_lg"
                android:src="@drawable/ic_nfc"
                app:tint="?attr/appGreen"
                android:contentDescription="@null" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/send_via_nfc"
                android:textColor="?attr/appTextPrimaryColor"
                android:textSize="13sp"
                android:gravity="center"
                android:maxLines="2"
                android:layout_marginTop="@dimen/space_sm" />
        </LinearLayout>
    </LinearLayout>

    <!-- Shown + the NFC option disabled when this device has no NFC hardware. -->
    <TextView
        android:id="@+id/tv_nfc_unavailable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:text="@string/send_via_nfc_unavailable"
        android:textColor="?attr/appError"
        android:textSize="13sp"
        android:gravity="center"
        android:visibility="gone"/>

</LinearLayout>
