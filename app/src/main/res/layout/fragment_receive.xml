<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBackgroundColor"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_xl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/space_xl"
            android:layout_marginTop="72dp"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/header_icon"
                android:layout_height="@dimen/header_icon"
                android:layout_marginEnd="@dimen/space_lg"
                android:src="@drawable/ic_hdr_receive"
                android:tint="?attr/appGreen"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tvReceiveTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/receive_title"
                android:textAppearance="@style/TextAppearance.App.Headline"
                android:textColor="?attr/appTextPrimaryColor" />

            <TextView
                android:id="@+id/btnHowToUse"
                style="@style/Widget.App.HowToUse" />
        </LinearLayout>

        <!-- Device name (mirrors System Status; sets how senders see this device) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/space_lg">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/device_name_label"
                android:textAppearance="@style/TextAppearance.App.Body"
                android:layout_marginEnd="@dimen/space_lg" />

            <EditText
                android:id="@+id/etReceiveDeviceName"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/rect_button_bg"
                android:paddingStart="@dimen/space_md"
                android:paddingEnd="@dimen/space_md"
                android:textColor="?attr/appTextPrimaryColor"
                android:textSize="14sp"
                android:inputType="text"
                android:singleLine="true"
                android:gravity="center_vertical|start" />
        </LinearLayout>

        <Button
            android:id="@+id/btnOpenCamera"
            style="@style/Widget.App.Button"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="@string/receive_open_camera"
            android:backgroundTint="?attr/appCardColor"
            android:textColor="?attr/appTextPrimaryColor"
            android:gravity="center"
            android:layout_marginBottom="@dimen/space_md" />

        <Button
            android:id="@+id/btnNfcToggle"
            style="@style/Widget.App.Button"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="@string/receive_nfc"
            android:backgroundTint="?attr/appCardColor"
            android:textColor="?attr/appTextPrimaryColor"
            android:gravity="center"
            android:layout_marginBottom="@dimen/space_md" />

        <TextView
            android:id="@+id/tvNfcUnavailable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/receive_nfc_unavailable_device"
            android:textColor="?attr/appError"
            android:textSize="13sp"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>
