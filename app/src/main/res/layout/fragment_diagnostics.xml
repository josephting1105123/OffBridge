<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBackgroundColor"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/diagnostics_title"
            android:textColor="?attr/appTextPrimaryColor"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/diagSessionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/appTextSecondaryColor"
            android:textSize="14sp"
            android:layout_marginBottom="12dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/diagEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/diagnostics_empty"
            android:textColor="?attr/appTextSecondaryColor"
            android:textSize="15sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/diagAttemptsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/diagTraceHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/diagnostics_trace_header"
            android:textColor="?attr/appTextPrimaryColor"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/diagTrace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="?attr/appTextSecondaryColor"
            android:textSize="11sp"
            android:textIsSelectable="true"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_diag_share"
            style="@style/Widget.App.Button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:text="@string/diagnostics_share"
            android:backgroundTint="?attr/appNavBarColor"
            android:textColor="?attr/appTextPrimaryColor"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
