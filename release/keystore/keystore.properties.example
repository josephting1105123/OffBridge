# Copy this file to the REPO ROOT as `keystore.properties` and fill in real values.
# The root keystore.properties is gitignored (so are *.jks / *.keystore) and is read by
# app/build.gradle.kts to sign the release build. When this file is ABSENT, the release
# build silently falls back to DEBUG signing — which Play rejects — so this must exist
# before you cut any build you intend to upload.

# Absolute path to the .jks produced by generate-upload-keystore.ps1
storeFile=C:\\Users\\YOU\\.android-keystores\\clipboardshare-upload.jks

# The keystore (store) password you entered in keytool
storePassword=CHANGE_ME

# The key alias (default from the generator script)
keyAlias=clipboardshare-upload

# The key password you entered in keytool (often the same as storePassword for PKCS12)
keyPassword=CHANGE_ME
