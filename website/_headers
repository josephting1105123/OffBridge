# Cloudflare Pages headers file — picked up automatically at deploy.
# CSP is intentionally omitted: the page relies on a few inline <script> blocks
# (theme init, JSON-LD, the gooey-loader) and this is a static site with no
# build step to inject nonces/hashes, so a CSP tight enough to matter would
# break the page. Everything below is safe to apply unconditionally.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=2592000

/css/*
  Cache-Control: public, max-age=86400

/js/*
  Cache-Control: public, max-age=86400

# Installer checksums the Windows in-app updater reads before running an update (UpdateInstaller).
# One immutable file per version, written by the commit-windows-version release skill.
/checksums/*
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300
